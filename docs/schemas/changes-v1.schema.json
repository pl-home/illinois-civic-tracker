{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pl-home.github.io/illinois-civic-tracker/schemas/changes-v1.schema.json",
  "title": "Shared change ledger interchange v1 (Stages A, B and C)",
  "description": "Structural contract only. Runtime source binding and publication policy are in changes.py. No schema validator/model establishes source facts.",
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "url",
        "retrieved_at",
        "binding"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "binding": {
          "enum": [
            "official-bill",
            "official-roll",
            "official-calendar",
            "publisher-listing",
            "screened-news-metadata",
            "party-page"
          ]
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "key",
        "kind",
        "jurisdiction",
        "session",
        "members",
        "occurred_at",
        "date_precision",
        "title",
        "detail",
        "evidence"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "filing",
            "sponsor-role",
            "bill-action",
            "bill-title",
            "vote",
            "hearing",
            "publication",
            "party-change"
          ]
        },
        "jurisdiction": {
          "enum": [
            "IL",
            "US",
            "LOCAL"
          ]
        },
        "session": {
          "enum": [
            104,
            119,
            null
          ]
        },
        "members": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "enum": [
              "fritts",
              "arellano",
              "lahood",
              "durbin",
              "duckworth"
            ]
          }
        },
        "occurred_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "date_precision": {
          "enum": [
            "day",
            "timestamp",
            "unknown"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "detail": {
          "type": "string",
          "maxLength": 2000
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "entities": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "enum": [
              "lee-democrats",
              "lee-gop"
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "party-change"
              }
            }
          },
          "then": {
            "required": [
              "entities",
              "publisher",
              "categories",
              "reasons",
              "before_sha256",
              "after_sha256",
              "before_excerpt",
              "after_excerpt",
              "previous_good_at",
              "after_gap",
              "observed_at"
            ],
            "properties": {
              "jurisdiction": {
                "const": "LOCAL"
              },
              "session": {
                "const": null
              },
              "members": {
                "maxItems": 0
              },
              "entities": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "members": {
                "minItems": 1
              },
              "jurisdiction": {
                "enum": [
                  "IL",
                  "US"
                ]
              },
              "session": {
                "enum": [
                  104,
                  119
                ]
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "revision_id",
        "revision",
        "supersedes",
        "scope",
        "fingerprint",
        "fact",
        "first_observed_at",
        "observed_at",
        "validation",
        "policy",
        "eligible",
        "inclusion_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^change-[a-f0-9]{24}$"
        },
        "revision_id": {
          "type": "string",
          "pattern": "^change-[a-f0-9]{24}-r[1-9][0-9]*$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fact": {
          "$ref": "#/$defs/fact"
        },
        "first_observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy": {
          "const": "stage-a-1"
        },
        "validation": {
          "const": "adapter-bound"
        },
        "eligible": {
          "type": "boolean"
        },
        "inclusion_reason": {
          "type": "string"
        },
        "hearing_changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "time-changed",
                  "location-changed",
                  "status-changed",
                  "notice-updated",
                  "agenda-added",
                  "agenda-removed",
                  "bill-postponed",
                  "agenda-item-updated"
                ]
              },
              "item": {
                "type": "string"
              },
              "before": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "after": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "adapter",
        "jurisdiction",
        "session",
        "checked_at",
        "fingerprint",
        "fact_count",
        "baseline_at",
        "reconcile_missing"
      ],
      "properties": {
        "adapter": {
          "type": "integer",
          "minimum": 1
        },
        "jurisdiction": {
          "enum": [
            "IL",
            "US",
            "LOCAL"
          ]
        },
        "session": {
          "enum": [
            104,
            119,
            null
          ]
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fact_count": {
          "type": "integer",
          "minimum": 0
        },
        "baseline_at": {
          "type": "string",
          "format": "date-time"
        },
        "reconcile_missing": {
          "type": "boolean"
        }
      }
    },
    "agendaItem": {
      "type": "object",
      "required": [
        "id",
        "bill",
        "amendment",
        "official_url",
        "contexts"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "bill": {
          "type": "string",
          "pattern": "^(HB|SB|HR|SR|HJR|SJR|HJRCA|SJRCA)[1-9][0-9]*$"
        },
        "amendment": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(HFA|SFA|HCA|SCA)[0-9]+$"
        },
        "official_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "contexts": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": [
              "motion",
              "vote_motion",
              "vote_result",
              "status"
            ],
            "properties": {
              "motion": {
                "type": "string",
                "maxLength": 1000
              },
              "vote_motion": {
                "type": "string",
                "maxLength": 1000
              },
              "vote_result": {
                "type": "string",
                "maxLength": 1000
              },
              "status": {
                "enum": [
                  null,
                  "canceled",
                  "postponed",
                  "rescheduled"
                ]
              }
            }
          }
        }
      }
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "policy",
    "scopes",
    "facts",
    "events",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy": {
      "const": "stage-a-1"
    },
    "scopes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/coverage"
      }
    },
    "facts": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "exceptions": {
      "type": "array",
      "maxItems": 64
    }
  }
}
